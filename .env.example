# Backend (Railway) uchun environment variables.
# Railway loyihasining "Variables" bo'limida shu qiymatlarni sozlang.

# /recommend endpoint'idagi tushuntirish uchun (ixtiyoriy — bo'lmasa oddiy
# ro'yxat qaytadi, xato bermaydi).
OPENAI_API_KEY=

# Netlify'dagi frontend production domeni (vergul bilan bir nechtasi
# mumkin). Masalan: https://your-site.netlify.app
ALLOWED_ORIGINS=

# Scraperlar necha soatda bir marta avtomatik ishga tushishi (ixtiyoriy,
# standart 24).
SCRAPE_INTERVAL_HOURS=24

# JWT tokenlarni imzolash uchun maxfiy kalit — majburiy, bo'lmasa backend
# ishga tushmaydi. Uzun, tasodifiy satr bo'lishi kerak (masalan:
# `python -c "import secrets; print(secrets.token_hex(32))"`).
AUTH_SECRET_KEY=

# Birinchi admin akkaunt — faqat "users" jadvali bo'sh bo'lganda (birinchi
# marta ishga tushirilganda) ishlatiladi. Keyinchalik admin panel orqali
# boshqa userlar qo'shiladi, bu ikkalasini o'chirib qo'yish mumkin.
ADMIN_USERNAME=
ADMIN_PASSWORD=
